# Copy this file to ".env" (git-ignored) and fill in real values, or export them as environment variables.
# Never commit the real .env file.

# --- Database (MySQL 8) ---
DB_URL=jdbc:mysql://localhost:3306/collabboard?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=collabboard
DB_PASSWORD=change-me

# --- Server ---
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080
# Set to true when served over HTTPS so the session cookie is only sent over TLS.
COOKIE_SECURE=false
SESSION_TIMEOUT=60m

# --- Email (Gmail SMTP with an App Password; see README "Email configuration") ---
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=collabboard.verify@gmail.com
# 16-character Google App Password (NOT the normal Gmail password). Spaces may be removed.
MAIL_PASSWORD=
MAIL_FROM=collabboard.verify@gmail.com
MAIL_FROM_NAME=CollabBoard
# DEVELOPMENT ONLY: when MAIL_ENABLED=false, print one-time codes to the server log.
MAIL_LOG_CODES=false

# --- Security ---
# Long random value (e.g. 64 hex chars). Generate with: openssl rand -hex 32
OTP_SECRET=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# --- Registration policy ---
# Comma separated college email domains. Empty = any domain (development only).
STUDENT_EMAIL_DOMAINS=
TEACHER_EMAIL_DOMAINS=

# --- File storage (outside the served web root) ---
STORAGE_ROOT=./data/uploads
MAX_UPLOAD_FILE_SIZE=50MB
MAX_UPLOAD_REQUEST_SIZE=120MB
